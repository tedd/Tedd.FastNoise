<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <NoiseProject Condition="'$(NoiseProject)' == ''">../../src/Tedd.FastNoise/Tedd.FastNoise.csproj</NoiseProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="EarthRecipe.cs" />
    <Compile Include="EarthScenario.cs" />
    <Compile Include="ColdCompositeScenario.cs" />
    <Compile Include="ColdEarthScenario.cs" />
    <ProjectReference Include="EarthBaseline/EarthBaseline.csproj" />
    <ProjectReference Include="$(NoiseProject)" Condition="'$(NoiseSourceDirectory)' == ''" />
    <Compile Include="$(NoiseSourceDirectory)/**/*.cs" Exclude="$(NoiseSourceDirectory)/**/obj/**/*.cs;$(NoiseSourceDirectory)/**/bin/**/*.cs" Condition="'$(NoiseSourceDirectory)' != ''" />
    <ProjectReference Include="$(BaselineProject)" Aliases="baseline" />
    <Reference Include="Tedd.DotNetLab.Harness" HintPath="$(DotNetLabDirectory)/Tedd.DotNetLab.Harness.dll" />
    <Reference Include="Tedd.DotNetLab.Contracts" HintPath="$(DotNetLabDirectory)/Tedd.DotNetLab.Contracts.dll" />
    <Reference Include="Tedd.DotNetLab.Transport.Local" HintPath="$(DotNetLabDirectory)/Tedd.DotNetLab.Transport.Local.dll" />
  </ItemGroup>
</Project>

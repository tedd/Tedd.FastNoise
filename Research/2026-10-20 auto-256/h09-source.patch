diff --git a/src/Tedd.FastNoise/Procedural/OpenSimplex3WideExpression.cs b/src/Tedd.FastNoise/Procedural/OpenSimplex3WideExpression.cs
new file mode 100644
index 0000000..73f7d1e
--- /dev/null
+++ b/src/Tedd.FastNoise/Procedural/OpenSimplex3WideExpression.cs
@@ -0,0 +1,126 @@
+// Expands a bounded immutable fractal shape into the enclosing SIMD procedural executor.
+// Coordinate products and octave accumulation retain the kernel's binary32 operation order.
+using System.Collections.Generic;
+using System.Linq.Expressions;
+using System.Numerics;
+using System.Reflection;
+using Tedd.FastNoise.Internal;
+using Tedd.FastNoise.Internal.Kernels;
+
+namespace Tedd.FastNoise.Procedural;
+
+internal static class OpenSimplex3WideExpression
+{
+    internal const int GraphOctaveBudget = 64;
+    internal const int MaximumSourceOctaves = 4;
+
+    private static readonly MethodInfo Sample = typeof(OpenSimplex2Kernel)
+        .GetMethod(nameof(OpenSimplex2Kernel.Sample3))!
+        .MakeGenericMethod(typeof(VectorOps), typeof(Vector<float>), typeof(Vector<int>));
+    private static readonly MethodInfo Abs = typeof(VectorOps).GetMethod(nameof(VectorOps.Abs))!;
+
+    internal static bool HasFiniteParameters(in NoiseFillRequest3D request)
+        => float.IsFinite(request.Frequency) && float.IsFinite(request.FractalBounding)
+            && float.IsFinite(request.Gain) && float.IsFinite(request.Lacunarity)
+            && float.IsFinite(request.WeightedStrength) && float.IsFinite(request.LastOctaveFade);
+
+    internal static bool TryEmit(in NoiseFillRequest3D request, Expression inputX, Expression inputY,
+        Expression inputZ, ref int remainingOctaves, out Expression expression)
+    {
+        expression = null!;
+        if (request.NoiseType != NoiseType.OpenSimplex2
+            || request.FractalType is not (FractalType.FBm or FractalType.Ridged)
+            || request.Octaves is < 1 or > MaximumSourceOctaves
+            || request.Octaves > remainingOctaves)
+            return false;
+
+        remainingOctaves -= request.Octaves;
+        var x = Expression.Variable(typeof(Vector<float>), "noiseX");
+        var y = Expression.Variable(typeof(Vector<float>), "noiseY");
+        var z = Expression.Variable(typeof(Vector<float>), "noiseZ");
+        var rotation = Expression.Variable(typeof(Vector<float>), "rotation");
+        var skew = Expression.Variable(typeof(Vector<float>), "skew");
+        var noise = Expression.Variable(typeof(Vector<float>), "noise");
+        var sum = Expression.Variable(typeof(Vector<float>), "sum");
+        var amplitude = Expression.Variable(typeof(Vector<float>), "amplitude");
+        var weight = Expression.Variable(typeof(Vector<float>), "weight");
+        List<Expression> body =
+        [
+            Expression.Assign(x, Expression.Multiply(inputX, F(request.Frequency))),
+            Expression.Assign(y, Expression.Multiply(inputY, F(request.Frequency))),
+            Expression.Assign(z, Expression.Multiply(inputZ, F(request.Frequency))),
+        ];
+
+        switch (request.RotationType3D)
+        {
+            case RotationType3D.ImproveXYPlanes:
+                body.Add(Expression.Assign(rotation, Expression.Add(x, y)));
+                body.Add(Expression.Assign(skew, Expression.Multiply(rotation, F(-0.211324865405187f))));
+                body.Add(Expression.Assign(z, Expression.Multiply(z, F(0.577350269189626f))));
+                body.Add(Expression.Assign(x, Expression.Add(x, Expression.Subtract(skew, z))));
+                body.Add(Expression.Assign(y, Expression.Subtract(Expression.Add(y, skew), z)));
+                body.Add(Expression.Assign(z, Expression.Add(z, Expression.Multiply(rotation, F(0.577350269189626f)))));
+                break;
+            case RotationType3D.ImproveXZPlanes:
+                body.Add(Expression.Assign(rotation, Expression.Add(x, z)));
+                body.Add(Expression.Assign(skew, Expression.Multiply(rotation, F(-0.211324865405187f))));
+                body.Add(Expression.Assign(y, Expression.Multiply(y, F(0.577350269189626f))));
+                body.Add(Expression.Assign(x, Expression.Add(x, Expression.Subtract(skew, y))));
+                body.Add(Expression.Assign(z, Expression.Add(z, Expression.Subtract(skew, y))));
+                body.Add(Expression.Assign(y, Expression.Add(y, Expression.Multiply(rotation, F(0.577350269189626f)))));
+                break;
+            default:
+                body.Add(Expression.Assign(rotation, Expression.Multiply(Expression.Add(Expression.Add(x, y), z), F(2f / 3f))));
+                body.Add(Expression.Assign(x, Expression.Subtract(rotation, x)));
+                body.Add(Expression.Assign(y, Expression.Subtract(rotation, y)));
+                body.Add(Expression.Assign(z, Expression.Subtract(rotation, z)));
+                break;
+        }
+
+        bool ridged = request.FractalType == FractalType.Ridged;
+        Expression Shape(Expression value) => ridged
+            ? Expression.Add(Expression.Multiply(Expression.Call(Abs, value), F(-2f)), F(1f)) : value;
+        if (request.Octaves == 1)
+        {
+            body.Add(Expression.Assign(noise, Expression.Call(Sample, I(request.Seed), x, y, z)));
+            body.Add(Expression.Multiply(Expression.Multiply(Shape(noise), F(request.FractalBounding)), F(request.LastOctaveFade)));
+        }
+        else
+        {
+            body.Add(Expression.Assign(sum, F(0f)));
+            body.Add(Expression.Assign(amplitude, F(request.FractalBounding)));
+            for (int octave = 0; octave < request.Octaves; octave++)
+            {
+                if (request.LastOctaveFade != 1f && octave == request.Octaves - 1)
+                    body.Add(Expression.Assign(amplitude, Expression.Multiply(amplitude, F(request.LastOctaveFade))));
+                body.Add(Expression.Assign(noise, Expression.Call(Sample, I(unchecked(request.Seed + octave)), x, y, z)));
+                if (request.FractalType == FractalType.Ridged)
+                {
+                    body.Add(Expression.Assign(noise, Expression.Call(Abs, noise)));
+                    body.Add(Expression.Assign(sum, Expression.Add(sum,
+                        Expression.Multiply(Expression.Add(Expression.Multiply(noise, F(-2f)), F(1f)), amplitude))));
+                    body.Add(Expression.Assign(weight, Expression.Subtract(F(1f), noise)));
+                }
+                else
+                {
+                    body.Add(Expression.Assign(sum, Expression.Add(sum, Expression.Multiply(noise, amplitude))));
+                    body.Add(Expression.Assign(weight, Expression.Multiply(Expression.Add(noise, F(1f)), F(.5f))));
+                }
+                body.Add(Expression.Assign(amplitude, Expression.Multiply(amplitude,
+                    Expression.Add(F(1f), Expression.Multiply(F(request.WeightedStrength), Expression.Subtract(weight, F(1f)))))));
+                body.Add(Expression.Assign(x, Expression.Multiply(x, F(request.Lacunarity))));
+                body.Add(Expression.Assign(y, Expression.Multiply(y, F(request.Lacunarity))));
+                body.Add(Expression.Assign(z, Expression.Multiply(z, F(request.Lacunarity))));
+                body.Add(Expression.Assign(amplitude, Expression.Multiply(amplitude, F(request.Gain))));
+            }
+            body.Add(sum);
+        }
+        expression = Expression.Block([x, y, z, rotation, skew, noise, sum, amplitude, weight], body);
+        return true;
+    }
+
+    // Boxed vector constants match the established wide emitter's representation. In particular,
+    // do not replace products by scalar-precomputed amplitudes or octave frequencies.
+    private static ConstantExpression F(float value) => Expression.Constant(new Vector<float>(value));
+    private static ConstantExpression I(int value) => Expression.Constant(new Vector<int>(value));
+}

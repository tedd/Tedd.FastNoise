+// Verifies typed stack fills against the retained fused executor, including backend-specific IEEE behavior.
+// Expected coordinates and blends come from the original grid path rather than the new DAG compiler.
+using System;
+using System.Linq;
+using System.Threading.Tasks;
+using Tedd.FastNoise.Internal;
+
+namespace Tedd.FastNoise.Tests;
+
+public class CompiledStack3DTests
+{
+    private static NoiseGenerator Source(int seed, NoiseType type = NoiseType.OpenSimplex2)
+        => new(seed)
+        {
+            NoiseType = type, Frequency = .013f, FractalType = FractalType.FBm, Octaves = 3,
+            WeightedStrength = .375f, Gain = .5f, Lacunarity = 2f, Lod = LodPolicy.Disabled,
+        };
+
+    private static void MatchesOriginal(CompiledNoiseStack stack, GridRegion3D region, NoiseBackend backend, string context = "")
+    {
+        const float sentinel = 12345.625f;
+        var expected = Enumerable.Repeat(sentinel, region.SampleCount + 3).ToArray();
+        var actual = Enumerable.Repeat(sentinel, expected.Length).ToArray();
+        var layers = stack.ResolveForProcedural(region.Step);
+        if (backend != NoiseBackend.Scalar && stack.IsVectorised)
+            StackFill.Rows3<VectorOps, System.Numerics.Vector<float>, System.Numerics.Vector<int>>(
+                layers, region, expected, 0, region.Height * region.Depth);
+        else
+            StackFill.Rows3<ScalarOps, float, int>(layers, region, expected, 0, region.Height * region.Depth);
+        stack.Fill(actual, region, backend);
+        for (int i = 0; i < expected.Length; i++)
+        {
+            int expectedBits = BitConverter.SingleToInt32Bits(expected[i]);
+            int actualBits = BitConverter.SingleToInt32Bits(actual[i]);
+            Assert.True(expectedBits == actualBits,
+                $"{context}; backend={backend}, region={region}, sample={i}, expected={expectedBits:X8}, actual={actualBits:X8}");
+        }
+    }
+
+    [Theory]
+    [InlineData(LayerBlend.Add)]
+    [InlineData(LayerBlend.Subtract)]
+    [InlineData(LayerBlend.Multiply)]
+    [InlineData(LayerBlend.Min)]
+    [InlineData(LayerBlend.Max)]
+    [InlineData(LayerBlend.Replace)]
+    [InlineData(LayerBlend.Lerp)]
+    public void EveryBlendPreservesScalarVectorAndParallelRows(LayerBlend blend)
+    {
+        var stack = new NoiseStack { ParallelThreshold = 1 };
+        NoiseType[] types = [NoiseType.OpenSimplex2, NoiseType.Perlin, NoiseType.ValueCubic, NoiseType.Cellular];
+        for (int i = 0; i < types.Length; i++)
+        {
+            var source = Source(1337 + i, types[i]);
+            source.FractalType = i % 2 == 0 ? FractalType.Ridged : FractalType.PingPong;
+            source.RotationType3D = i % 2 == 0 ? RotationType3D.ImproveXYPlanes : RotationType3D.ImproveXZPlanes;
+            stack.Add(new NoiseLayer { Source = source, Blend = blend, Amplitude = -.375f,
+                Offset = .125f, BlendFactor = .3125f });
+        }
+        var compiled = stack.Compile();
+        foreach (int width in new[] { 1, 7, 8, 9, 17, 64 })
+        foreach (float step in new[] { .75f, 13.25f })
+        foreach (var backend in new[] { NoiseBackend.Scalar, NoiseBackend.Simd, NoiseBackend.Parallel, NoiseBackend.Auto })
+            MatchesOriginal(compiled, new GridRegion3D(-131073.375f, 7.25f, -29.125f, width, 3, 2, step), backend);
+    }
+
+    [Theory]
+    [InlineData(LayerBlend.Min)]
+    [InlineData(LayerBlend.Max)]
+    public void BlendPreservesOriginalBackendNaNsAndSignedZeros(LayerBlend blend)
+    {
+        int[] bits = [0, int.MinValue, 0x3f800000, 0x7fc12345, unchecked((int)0xffc54321), 0x7f812345];
+        foreach (int first in bits)
+        foreach (int second in bits)
+        {
+            var stack = new NoiseStack { ParallelThreshold = 1 };
+            stack.Add(new NoiseLayer { Source = Source(1), Amplitude = 0f, Offset = BitConverter.Int32BitsToSingle(first) });
+            stack.Add(new NoiseLayer { Source = Source(2), Amplitude = 0f, Offset = BitConverter.Int32BitsToSingle(second), Blend = blend });
+            var compiled = stack.Compile();
+            foreach (var backend in new[] { NoiseBackend.Scalar, NoiseBackend.Simd, NoiseBackend.Parallel })
+                MatchesOriginal(compiled, new GridRegion3D(-2f, 3f, 5f, 17, 1, 1), backend);
+        }
+    }
+
+    [Theory]
+    [InlineData(LayerBlend.Add)]
+    [InlineData(LayerBlend.Multiply)]
+    [InlineData(LayerBlend.Lerp)]
+    public void ExceptionalCoordinatesAndContributionsPreserveOriginalBits(LayerBlend blend)
+    {
+        float nanA = BitConverter.Int32BitsToSingle(0x7fc12345);
+        float nanB = BitConverter.Int32BitsToSingle(unchecked((int)0xffc54321));
+        float negativeZero = BitConverter.Int32BitsToSingle(int.MinValue);
+        (float FirstAmplitude, float FirstOffset, float SecondAmplitude, float SecondOffset, float Factor)[] cases =
+        [
+            (nanA, nanB, nanB, nanA, .25f),
+            (float.PositiveInfinity, float.NegativeInfinity, 0f, negativeZero, nanB),
+            (negativeZero, negativeZero, 0f, 0f, float.PositiveInfinity),
+            (.5f, nanA, nanB, float.NegativeInfinity, nanA),
+        ];
+        int width = System.Numerics.Vector<float>.Count + 1;
+        foreach (var values in cases)
+        {
+            var stack = new NoiseStack { Lod = LodPolicy.Disabled };
+            // Identical noise requests exercise DAG common-subexpression elimination. The first
+            // layer's Lerp factor is deliberately NaN: its blend must remain completely ignored.
+            stack.Add(new NoiseLayer { Source = Source(91), Blend = LayerBlend.Lerp, BlendFactor = nanB,
+                Amplitude = values.FirstAmplitude, Offset = values.FirstOffset });
+            stack.Add(new NoiseLayer { Source = Source(91), Blend = blend, BlendFactor = values.Factor,
+                Amplitude = values.SecondAmplitude, Offset = values.SecondOffset });
+            var compiled = stack.Compile();
+            GridRegion3D[] regions =
+            [
+                new(-13.5f, 7.25f, -3.125f, width, 1, 1, .75f),
+                new(nanA, float.PositiveInfinity, float.NegativeInfinity, width, 1, 1, .75f),
+                new(float.NegativeInfinity, 7.25f, nanB, width, 1, 1, .75f),
+            ];
+            foreach (var region in regions)
+            foreach (var backend in new[] { NoiseBackend.Scalar, NoiseBackend.Simd })
+                MatchesOriginal(compiled, region, backend,
+                    $"blend={blend}; firstAmplitude={BitConverter.SingleToInt32Bits(values.FirstAmplitude):X8}; firstOffset={BitConverter.SingleToInt32Bits(values.FirstOffset):X8}; secondAmplitude={BitConverter.SingleToInt32Bits(values.SecondAmplitude):X8}; secondOffset={BitConverter.SingleToInt32Bits(values.SecondOffset):X8}; factor={BitConverter.SingleToInt32Bits(values.Factor):X8}");
+        }
+    }
+
+    [Theory]
+    [InlineData(LayerBlend.Add, false)]
+    [InlineData(LayerBlend.Add, true)]
+    [InlineData(LayerBlend.Multiply, false)]
+    [InlineData(LayerBlend.Multiply, true)]
+    [InlineData(LayerBlend.Lerp, false)]
+    [InlineData(LayerBlend.Lerp, true)]
+    public void FiniteContributionsPreserveNonfiniteCoordinatesAndOverflow(LayerBlend blend, bool commonNoise)
+    {
+        float nanA = BitConverter.Int32BitsToSingle(0x7fc12345);
+        float nanB = BitConverter.Int32BitsToSingle(unchecked((int)0xffc54321));
+        int width = System.Numerics.Vector<float>.Count + 1;
+        foreach (bool overflow in new[] { false, true })
+        {
+            var stack = new NoiseStack { Lod = LodPolicy.Disabled };
+            stack.Add(new NoiseLayer { Source = Source(91), Amplitude = overflow ? float.MaxValue : .75f,
+                Offset = overflow ? float.MaxValue : .125f });
+            stack.Add(new NoiseLayer { Source = Source(commonNoise ? 91 : 123), Blend = blend,
+                Amplitude = overflow ? -float.MaxValue : .25f, Offset = overflow ? -float.MaxValue : -.125f,
+                BlendFactor = overflow ? float.MaxValue : .375f });
+            var compiled = stack.Compile();
+            GridRegion3D[] regions =
+            [
+                new(-13.5f, 7.25f, -3.125f, width, 1, 1, .75f),
+                new(nanA, 7.25f, -3.125f, width, 1, 1, .75f),
+                new(float.PositiveInfinity, float.NegativeInfinity, nanB, width, 1, 1, .75f),
+                new(float.MaxValue, -float.MaxValue, float.MaxValue, width, 1, 1, float.MaxValue),
+            ];
+            foreach (var region in regions)
+            foreach (var backend in new[] { NoiseBackend.Scalar, NoiseBackend.Simd })
+                MatchesOriginal(compiled, region, backend, $"blend={blend}; commonNoise={commonNoise}; overflow={overflow}");
+        }
+    }
+
+    [Fact]
+    public void ResolvedProgramsPreserveLayerCullingOctaveFadeAndReplacement()
+    {
+        var stack = new NoiseStack { Lod = LodPolicy.Automatic with { CullLayers = true }, ParallelThreshold = 1 };
+        stack.Add(new NoiseLayer { Source = Source(1), Amplitude = .75f, FeatureSize = 100000f });
+        stack.Add(new NoiseLayer { Source = Source(2), Blend = LayerBlend.Replace, FeatureSize = 64f });
+        stack.Add(new NoiseLayer { Source = Source(3), Blend = LayerBlend.Subtract, FeatureSize = 8192f, Amplitude = .25f });
+        var compiled = stack.Compile();
+        foreach (float step in new[] { .25f, 1f, 7f, 32f, 256f, 4096f, 100000f, 1f })
+        foreach (var backend in new[] { NoiseBackend.Scalar, NoiseBackend.Simd, NoiseBackend.Parallel })
+            MatchesOriginal(compiled, new GridRegion3D(-137f, 87f, -23f, 17, 3, 2, step), backend);
+    }
+
+    [Fact]
+    public void ManyLodStridesAndPreviouslyCachedStepsRemainExact()
+    {
+        var stack = new NoiseStack { Lod = LodPolicy.Automatic with { CullLayers = true }, ParallelThreshold = 1 };
+        stack.Add(new NoiseLayer { Source = Source(41), FeatureSize = 10000f, Amplitude = .75f });
+        stack.Add(new NoiseLayer { Source = Source(43), FeatureSize = 64f, Blend = LayerBlend.Subtract });
+        var compiled = stack.Compile();
+        // Exceed the dynamic-code budget with nonempty programs, then revisit earlier strides.
+        // This exercises uncached fused fills, continuous fades, layer culling and retained programs.
+        var strides = Enumerable.Range(0, 24).Select(index => 2f + index * 2.25f).Concat([2f, 4.25f, 1000f]);
+        foreach (float step in strides)
+        foreach (var backend in new[] { NoiseBackend.Scalar, NoiseBackend.Simd, NoiseBackend.Parallel })
+            MatchesOriginal(compiled, new GridRegion3D(-31.5f, 11.25f, -7f, 17, 2, 1, step), backend);
+    }
+
+    [Fact]
+    public void ConcurrentFirstUsePreservesSnapshotsAcrossDisabledLodStrides()
+    {
+        var source = Source(19);
+        var stack = new NoiseStack { Lod = LodPolicy.Disabled, ParallelThreshold = int.MaxValue };
+        stack.Add(new NoiseLayer { Source = source });
+        stack.Add(new NoiseLayer { Source = Source(23), Blend = LayerBlend.Multiply, Offset = .5f, Amplitude = .5f });
+        var compiled = stack.Compile();
+        source.Seed = 999;
+        source.FractalType = FractalType.None;
+        Parallel.For(0, 12, index =>
+            MatchesOriginal(compiled, new GridRegion3D(index - 100.5f, 7.25f, 19f, 17, 2, 1, .25f * (index + 1)), NoiseBackend.Auto));
+    }
+
+    [Fact]
+    public void ScalarOnlyStacksRetainTheirOriginalFallback()
+    {
+        var stack = new NoiseStack { ParallelThreshold = 1 };
+        stack.Add(new NoiseLayer { Source = Source(1) });
+        stack.Add(new NoiseLayer { Source = Source(2, NoiseType.OpenSimplex2S), Amplitude = .5f });
+        var compiled = stack.Compile();
+        Assert.False(compiled.IsVectorised);
+        foreach (var backend in new[] { NoiseBackend.Scalar, NoiseBackend.Simd, NoiseBackend.Parallel })
+            MatchesOriginal(compiled, new GridRegion3D(1f, -2f, 3f, 17, 3, 2, .75f), backend);
+    }
+}

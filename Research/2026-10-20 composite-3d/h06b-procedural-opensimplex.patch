+    private unsafe void FillParallel(ReadOnlySpan<double> inputs, Span<double> outputs, int sampleCount)
+    {
+        int lanes = _executeWide is null ? 1 : Vector<float>.Count;
+        int groups = sampleCount / lanes;
+        int workers = Math.Min(Environment.ProcessorCount, sampleCount / 1024);
+        int groupsPerWorker = 1 + (groups - 1) / workers;
+
+        // Partition whole SIMD groups so every record uses exactly the same SIMD/scalar path as
+        // a sequential fill. Only the final range may contain the original scalar tail.
+        fixed (double* inputOrigin = inputs)
+        fixed (double* outputOrigin = outputs)
+        {
+            nint inputAddress = (nint)inputOrigin, outputAddress = (nint)outputOrigin;
+            System.Threading.Tasks.Parallel.For(0, workers, worker =>
+            {
+                int firstGroup = worker * groupsPerWorker;
+                if (firstGroup >= groups) return;
+                int lastGroup = firstGroup + Math.Min(groups - firstGroup, groupsPerWorker);
+                int first = firstGroup * lanes;
+                int count = lastGroup == groups ? sampleCount - first : (lastGroup - firstGroup) * lanes;
+                FillSequential(new ReadOnlySpan<double>((double*)inputAddress + first * InputCount, count * InputCount),
+                    new Span<double>((double*)outputAddress + first * OutputCount, count * OutputCount), count, true);
+            });
+        }
+    }

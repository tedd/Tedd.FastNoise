+    /// <summary>Looks up packed gradient codes with byte shuffles, retaining the portable gather fallback.</summary>
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
+    public static Vector<int> GradientCode3(Vector<int> indices)
+    {
+        if (Avx2.IsSupported && Vector<int>.Count == Vector256<int>.Count)
+        {
+            Vector256<int> idx = Unsafe.As<Vector<int>, Vector256<int>>(ref indices);
+            Vector256<byte> control = ((idx & Vector256.Create(15)) | Vector256.Create(unchecked((int)0x80808000))).AsByte();
+            ref byte origin = ref MemoryMarshal.GetReference(Tables.GradientCodeBytes3D);
+            var a = Vector128.LoadUnsafe(ref origin);
+            var b = Vector128.LoadUnsafe(ref origin, 16);
+            var c = Vector128.LoadUnsafe(ref origin, 32);
+            var d = Vector128.LoadUnsafe(ref origin, 48);
+            var r0 = Avx2.Shuffle(Vector256.Create(a, a), control);
+            var r1 = Avx2.Shuffle(Vector256.Create(b, b), control);
+            var r2 = Avx2.Shuffle(Vector256.Create(c, c), control);
+            var r3 = Avx2.Shuffle(Vector256.Create(d, d), control);
+            var bit4 = Avx2.CompareGreaterThan(idx & Vector256.Create(16), Vector256<int>.Zero).AsByte();
+            var bit5 = Avx2.CompareGreaterThan(idx & Vector256.Create(32), Vector256<int>.Zero).AsByte();
+            var result = Avx2.BlendVariable(Avx2.BlendVariable(r0, r1, bit4), Avx2.BlendVariable(r2, r3, bit4), bit5).AsInt32();
+            return Unsafe.As<Vector256<int>, Vector<int>>(ref result);
+        }
+        return GatherI(Tables.GradientCodes3D, indices);
+    }
+

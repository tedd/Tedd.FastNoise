 using System;
+using System.Numerics;
 using Tedd.FastNoise.Internal;
 
 namespace Tedd.FastNoise.Tests;
 
 public class GradientEncodingTests
 {
+    [Fact]
+    public void Vector3DGradientCodeLookupMatchesEveryPackedEntry()
+    {
+        Span<int> indices = stackalloc int[Vector<int>.Count];
+        for (int first = 0; first < 64; first += indices.Length)
+        {
+            for (int lane = 0; lane < indices.Length; lane++) indices[lane] = (first + lane) % 64;
+            Vector<int> actual = VectorOps.GradientCode3(new Vector<int>(indices));
+            for (int lane = 0; lane < indices.Length; lane++)
+                Assert.Equal(Tables.GradientCodes3D[indices[lane]], actual[lane]);
+        }
+    }
+

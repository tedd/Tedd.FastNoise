+    private CompiledStack3D? ResolveExecutor3D(float step)
+    {
+        // Without either LOD policy, spacing changes traversal but never the resolved noise program.
+        float key = !_lod.CullLayers && !_lod.CullOctaves ? 1f : step;
+        Lazy<CompiledStack3D> executor;
+        lock (_executors3D)
+        {
+            if (!_executors3D.TryGetValue(key, out executor!))
+            {
+                // Keep existing programs; unusual additional strides use the original fused fill.
+                if (_executors3D.Count >= MaximumExecutors3D) return null;
+                executor = new Lazy<CompiledStack3D>(() =>
+                {
+                    var graph = new ProceduralGraph();
+                    var x = graph.Input(0, ProceduralType.Float32);
+                    var y = graph.Input(1, ProceduralType.Float32);
+                    var z = graph.Input(2, ProceduralType.Float32);
+                    return graph.CompileFloat3D(graph.Stack3D(this, x, y, z, key));
+                }, LazyThreadSafetyMode.ExecutionAndPublication);
+                _executors3D.Add(key, executor);
+            }
+        }
+        // Dynamic compilation must not serialize cached fills or hold either cache lock.
+        return executor.Value;
+    }
+

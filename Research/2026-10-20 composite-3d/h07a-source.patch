+++ b/src/Tedd.FastNoise/Procedural/CompiledStack3D.cs
@@ -0,0 +1,52 @@
+// Compiles a resolved stack's Float32 DAG into immutable native-coordinate delegates.
+// Grid traversal remains outside this compiler; SIMD blend min/max retain the original stack semantics.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Linq.Expressions;
+using System.Numerics;
+using Tedd.FastNoise.Internal;
+
+namespace Tedd.FastNoise.Procedural;
+
+internal sealed class CompiledStack3D
+{
+    internal readonly Func<float, float, float, float> Scalar;
+    internal readonly Func<Vector<float>, Vector<float>, Vector<float>, Vector<float>>? Wide;
+
+    internal CompiledStack3D(ProceduralNode[] nodes, int output)
+    {
+        Scalar = Compile<Func<float, float, float, float>>(nodes, output, false);
+        if (Vector.IsHardwareAccelerated)
+            Wide = Compile<Func<Vector<float>, Vector<float>, Vector<float>, Vector<float>>>(nodes, output, true);
+    }
+
+    private static TDelegate Compile<TDelegate>(ProceduralNode[] nodes, int output, bool wide) where TDelegate : Delegate
+    {
+        Type type = wide ? typeof(Vector<float>) : typeof(float);
+        var inputs = new[] { Expression.Parameter(type, "x"), Expression.Parameter(type, "y"), Expression.Parameter(type, "z") };
+        var locals = nodes.Select(n => Expression.Variable(type, $"n{n.Id}")).ToArray();
+        List<Expression> body = [];
+        foreach (var node in nodes)
+        {
+            if (node.Type != ProceduralType.Float32)
+                throw new NotSupportedException("Native stack executors require Float32 nodes.");
+            Expression value;
+            if (node.Operation == ProceduralOperation.Input)
+                value = inputs[node.InputIndex];
+            else if (wide && node.Operation is ProceduralOperation.Min or ProceduralOperation.Max)
+                // Procedural min/max deliberately normalize NaN and zero behavior. Stack fills must
+                // retain VectorOps' existing behavior, including operand order and exceptional values.
+                value = ProceduralRuntime.Call(typeof(VectorOps),
+                    node.Operation == ProceduralOperation.Min ? nameof(VectorOps.Min) : nameof(VectorOps.Max),
+                    locals[node.A], locals[node.B]);
+            else
+                value = wide
+                    ? ProceduralWideRuntime.Emit(node, id => locals[id], id => nodes[id].Type)
+                    : ProceduralRuntime.Emit(node, id => locals[id]);
+            body.Add(Expression.Assign(locals[node.Id], value));
+        }
+        body.Add(locals[output]);
+        return Expression.Lambda<TDelegate>(Expression.Block(locals, body), inputs).Compile();
+    }
+}

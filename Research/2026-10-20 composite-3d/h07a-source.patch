+    // Keep the original row boundaries and ramp association: regrouping samples changes float coordinates.
+    internal static void Rows3(CompiledStack3D executor, ResolvedLayer[] layers, in GridRegion3D region,
+        Span<float> destination, int firstRow, int rowCount, bool wide)
+    {
+        var scalar = executor.Scalar;
+        var vector = wide ? executor.Wide : null;
+        int lanes = Vector<float>.Count;
+        int width = region.Width;
+        int height = region.Height;
+        float step = region.Step;
+        for (int row = firstRow; row < firstRow + rowCount; row++)
+        {
+            int y = row % height;
+            int z = row / height;
+            float worldY = region.OriginY + (y * step);
+            float worldZ = region.OriginZ + (z * step);
+            int rowStart = row * width;
+            int column = 0;
+            if (vector is not null)
+                for (; column + lanes <= width; column += lanes)
+                {
+                    var baseX = VectorOps.Ramp(region.OriginX + (column * step), step);
+                    var value = vector(baseX, VectorOps.F(worldY), VectorOps.F(worldZ));
+                    // Preserve the retained executor's NaN payload selection. Test the result so
+                    // finite settings that generate NaNs through overflow receive the same treatment.
+                    if (!Vector.EqualsAll(value, value))
+                        value = Evaluate3<VectorOps, Vector<float>, Vector<int>>(
+                            layers, baseX, VectorOps.F(worldY), VectorOps.F(worldZ));
+                    VectorOps.Store(value, destination, rowStart + column);
+                }
+            for (; column < width; column++)
+            {
+                float value = scalar(region.OriginX + (column * step), worldY, worldZ);
+                if (float.IsNaN(value))
+                    value = Evaluate3<ScalarOps, float, int>(layers, region.OriginX + (column * step), worldY, worldZ);
+                destination[rowStart + column] = value;
+            }
+        }
+    }
+

<Application x:Class="Tedd.FastNoise.Designer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!--
            A dark shell, because the previews are the only thing that should be bright.

            The stock WPF control chrome is light grey and mostly ignores Background, so buttons and
            combo boxes get minimal templates here rather than setters that would be silently
            dropped. Everything else just needs colours.
        -->

        <SolidColorBrush x:Key="Shell.Background" Color="#FF1E1F22" />
        <SolidColorBrush x:Key="Shell.Panel" Color="#FF2B2D30" />
        <SolidColorBrush x:Key="Shell.Control" Color="#FF3A3D42" />
        <SolidColorBrush x:Key="Shell.ControlHover" Color="#FF4A4E54" />
        <SolidColorBrush x:Key="Shell.ControlPressed" Color="#FF26282C" />
        <SolidColorBrush x:Key="Shell.Border" Color="#FF4A4D52" />
        <SolidColorBrush x:Key="Shell.Foreground" Color="#FFDCDCDC" />
        <SolidColorBrush x:Key="Shell.Muted" Color="#FF9DA0A6" />
        <SolidColorBrush x:Key="Shell.Accent" Color="#FF3D6FC4" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Shell.Foreground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Shell.Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Shell.Muted}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Shell.Muted}" />
            <Setter Property="BorderBrush" Value="{StaticResource Shell.Border}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF17181B" />
            <Setter Property="Foreground" Value="{StaticResource Shell.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Shell.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="CaretBrush" Value="{StaticResource Shell.Foreground}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Shell.Accent}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Shell.Foreground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Shell.Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Shell.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Shell.Border}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF34373C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Shell.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Shell.Control}" />
            <Setter Property="Foreground" Value="{StaticResource Shell.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Shell.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Shell.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Shell.ControlPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The drop-down arrow, as a borderless toggle inside the combo box template. -->
        <Style x:Key="ComboBoxToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Shell.Control}" />
            <Setter Property="Foreground" Value="{StaticResource Shell.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Shell.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    IsHitTestVisible="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />

                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource Shell.Muted}" />
                                </Grid>
                            </Border>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border Background="{StaticResource Shell.Panel}"
                                        BorderBrush="{StaticResource Shell.Border}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="320">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{StaticResource Shell.Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Shell.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!--
            The stock slider has a 4px track and a small thumb, which is fine for a volume control
            and poor for a value you are trying to explore. Bigger thumb, thicker track, and
            click-anywhere-to-jump.
        -->
        <Style TargetType="Thumb" x:Key="SliderThumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Grip" Width="15" Height="15"
                                     Fill="{StaticResource Shell.Foreground}"
                                     Stroke="{StaticResource Shell.Background}" StrokeThickness="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Fill" Value="{StaticResource Shell.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Fill" Value="{StaticResource Shell.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="#FF17181B" BorderBrush="{StaticResource Shell.Border}"
                                    BorderThickness="1" />

                            <Track x:Name="PART_Track" Grid.Row="0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"
                                                  Margin="0" MinWidth="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"
                                                  Margin="0" MinWidth="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>

                            <TickBar Grid.Row="1" x:Name="TopTick" Height="4" Fill="{StaticResource Shell.Border}"
                                     Placement="Bottom" Visibility="Collapsed"
                                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TickPlacement" Value="BottomRight">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tedd.FastNoise.Designer\Tedd.FastNoise.Designer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

